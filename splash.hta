<!DOCTYPE html>
<html>
<head>
    <title>School Management System - Starting</title>
    <HTA:APPLICATION 
        ID="oHTA"
        APPLICATIONNAME="SMS-Splash"
        BORDER="none"
        CAPTION="no"
        SHOWINTASKBAR="no"
        SINGLEINSTANCE="yes"
        SYSMENU="no"
        SCROLL="no"
        WINDOWSTATE="normal"
        INNERBORDER="no"
        SELECTION="no"
        CONTEXTMENU="no"
    />
    <style>
        * { box-sizing: border-box; }
        body {
            background: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100vh;
            border: 3px solid #2196F3;
        }
        .container {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            height: 100%;
            padding: 40px;
            text-align: center;
        }
        .header-section {
            width: 100%;
            margin-top: 20px;
        }
        .welcome-badge {
            background: #e3f2fd;
            padding: 12px 25px;
            border-radius: 50px;
            color: #1976d2;
            font-weight: 700;
            font-size: 20px;
            display: inline-block;
            margin-bottom: 20px;
            border: 1px solid #bbdefb;
            box-shadow: 0 4px 15px rgba(25, 118, 210, 0.1);
        }
        h1 {
            color: #0d47a1;
            margin: 10px 0;
            font-size: 28px;
            font-weight: 800;
            line-height: 1.3;
        }
        .middle-section {
            width: 100%;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .progress-box {
            width: 90%;
            margin: 0 auto;
        }
        .progress-bg {
            background: #eeeeee;
            height: 12px;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 12px;
            border: 1px solid #e0e0e0;
        }
        .progress-fill {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #42a5f5, #1976d2);
            transition: width 0.4s ease;
        }
        .status-msg {
            font-size: 15px;
            color: #607d8b;
            font-weight: 600;
        }
        .footer-section {
            width: 100%;
            padding-top: 25px;
            border-top: 1px solid #f5f5f5;
        }
        .dev-badge {
            font-size: 13px;
            color: #78909c;
            display: block;
            margin-bottom: 5px;
        }
        .dev-name {
            color: #1565c0;
            font-weight: 700;
            font-size: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-section">
            <div class="welcome-badge">Assalam-o-Alaikum! Welcome Student</div>
            <h1>Welcome to the School Management System</h1>
        </div>
        
        <div class="middle-section">
            <div class="progress-box">
                <div class="progress-bg">
                    <div class="progress-fill" id="progressBar"></div>
                </div>
                <div class="status-msg" id="statusText">Starting system services...</div>
            </div>
        </div>

        <div class="footer-section">
            <span class="dev-badge">Developed by:</span>
            <span class="dev-name">AR Software Solution | Abdul Rafay Qazi</span>
        </div>
    </div>

    <script language="VBScript">
        Sub Window_OnLoad
            ' Dimensions for a clean, non-image look
            width = 600
            height = 500
            window.resizeTo width, height
            window.moveTo (screen.width - width) / 2, (screen.height - height) / 2
            
            window.setTimeout "StartProcess", 1000
        End Sub

        Sub StartProcess
            UpdateStatus "Verifying XAMPP Services...", 30
            
            Set shell = CreateObject("WScript.Shell")
            Set wmi = GetObject("winmgmts://./root/cimv2")
            
            Set procs = wmi.ExecQuery("Select * from Win32_Process Where Name = 'httpd.exe'")
            
            If procs.Count = 0 Then
                UpdateStatus "Starting Apache Server (XAMPP)...", 60
                shell.Run "C:\xampp\apache_start.bat", 0, False
                window.setTimeout "CompleteProcess", 4000
            Else
                UpdateStatus "System services are ready!", 80
                window.setTimeout "CompleteProcess", 1500
            End If
        End Sub

        Sub UpdateStatus(text, percent)
            document.getElementById("statusText").innerHTML = text
            document.getElementById("progressBar").style.width = percent & "%"
        End Sub

        Sub CompleteProcess
            UpdateStatus "Connecting to Database...", 90
            window.setTimeout "LaunchApp", 1000
        End Sub

        Sub LaunchApp
            UpdateStatus "Launching SMS...", 100
            Set shell = CreateObject("WScript.Shell")
            Set fso = CreateObject("Scripting.FileSystemObject")
            
            ' Get current absolute folder path robustly
            cmd = oHTA.commandLine
            firstQuote = InStr(cmd, """")
            lastQuote = InStrRev(cmd, """")
            If firstQuote > 0 And lastQuote > firstQuote Then
                htaPath = Mid(cmd, firstQuote + 1, lastQuote - firstQuote - 1)
                htaDir = fso.GetParentFolderName(htaPath)
            Else
                ' Fallback if no quotes
                htaDir = shell.CurrentDirectory
            End If
            
            ' Extract the folder name from the path
            folderName = fso.GetBaseName(htaDir)
            
            ' Construct the URL dynamically
            url = "http://localhost/" & folderName & "/"
            
            ' App mode for professional look
            command = "cmd /c start chrome --app=" & url
            shell.Run command, 0, False
            window.setTimeout "window.close()", 1500
        End Sub

    </script>
</body>
</html>
